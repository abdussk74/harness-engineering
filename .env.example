# Copy to .env and fill in what you need. Nothing here is required for
# `harness dev` to boot; unset values fall back to sane local defaults.

# Bearer token required on every request to your agent's A2A server.
# Unset = no auth (fine for pure-localhost dev).
HARNESS_API_TOKEN=

# LLM provider credentials (lands in M7) — the agent's own concern, not
# Harness-prefixed, since these are your model provider's env var names.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# LangSmith tracing (lands in M7) — optional, enabled only if set.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=
