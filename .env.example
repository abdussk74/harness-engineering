# Copy to .env and fill in what you need. Nothing here is required for
# `harness dev` to boot; unset values fall back to sane local defaults.

# Bearer token required on every request to your agent's A2A server.
# Unset = no auth (fine for pure-localhost dev).
HARNESS_API_TOKEN=

# ctx.llm's provider ("anthropic" default, "openai", or "ollama") and
# model. Required for openai/ollama, which have no universal default.
# HARNESS_LLM_PROVIDER=
# HARNESS_LLM_MODEL=
# HARNESS_OLLAMA_BASE_URL=http://localhost:11434

# LLM provider credentials — the agent's own concern, not Harness-
# prefixed, since these are your model provider's own env var names.
# Read directly by LangChain, not by Harness.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# LangSmith tracing — optional, enabled only if set. Read directly by
# LangChain, not by Harness.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=
